@model Warehouse_24dh111674.Models.Product
@{
    ViewBag.Title = "Thêm sản phẩm mới";
}

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold text-primary">Câu 6: Thêm sản phẩm mới</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Create", "Products", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, "Dữ liệu không hợp lệ (chưa lưu vào CSDL):")
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.ProductName, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Ví dụ: Màn hình LG - Trần Quốc Thành" })
                    @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Category, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "Ví dụ: Điện tử - Trần Quốc Thành" })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Price, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Giá > 0" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Quantity, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", placeholder = "Số nguyên >= 0" })
                    @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 mt-3">
                    <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-secondary ms-2">Quay lại danh sách</a>
                </div>
            </div>
        }
    </div>
</div>
