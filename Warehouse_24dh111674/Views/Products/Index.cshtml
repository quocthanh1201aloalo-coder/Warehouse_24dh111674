@model IEnumerable<Warehouse_24dh111674.Models.Product>
@{
    ViewBag.Title = "Danh sách sản phẩm";
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center py-3">
        <div>
            <h5 class="mb-0 fw-bold text-primary">Câu 2: Danh sách sản phẩm &amp; Xóa sản phẩm hết hàng</h5>
            <small class="text-muted">Trạng thái: Hết hàng (= 0) | Sắp hết hàng (1–4) | Còn hàng (&ge; 5)</small>
        </div>
        <a href="@Url.Action("Create", "Products")" class="btn btn-primary btn-sm">+ Thêm sản phẩm mới</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên sản phẩm (ProductName)</th>
                        <th>Danh mục (Category)</th>
                        <th class="text-end">Đơn giá (Price)</th>
                        <th class="text-center">Số lượng (Quantity)</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm nào trong kho.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProductID</td>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td>@item.Category</td>
                                <td class="text-end">@item.Price.ToString("N2") VNĐ</td>
                                <td class="text-center fw-bold">@item.Quantity</td>
                                <td class="text-center">
                                    <span class="badge @item.StockBadgeClass">@item.StockStatus</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Quantity == 0)
                                    {
                                        <a href="@Url.Action("Delete", "Products", new { id = item.ProductID })"
                                           class="btn btn-danger btn-sm">
                                            Xóa
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Delete", "Products", new { id = item.ProductID })"
                                           class="btn btn-outline-secondary btn-sm"
                                           title="Chỉ xóa được khi Quantity = 0">
                                            Xóa (Còn hàng)
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
