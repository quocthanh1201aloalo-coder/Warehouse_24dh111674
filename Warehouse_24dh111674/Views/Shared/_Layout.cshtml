@{
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Warehouse_24dh111674</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>
    <header class="app-header shadow-sm py-3">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <h4 class="mb-0 fw-bold">HỆ THỐNG QUẢN LÝ KHO HÀNG (Warehouse_24dh111674)</h4>
                <small class="opacity-75">ASP.NET MVC (.NET Framework) - Entity Framework Database First</small>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-primary fs-6 px-3 py-2">
                    Sinh viên: Trần Quốc Thành | MSSV: 24dh111674
                </span>
            </div>
        </div>
    </header>

    <div class="container-fluid px-4 py-4 app-body">
        <div class="row g-4">
            <aside class="col-12 col-md-3 col-lg-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold">
                        MENU CHỨC NĂNG (CÂU 2 – 7)
                    </div>
                    <div class="card-body p-2">
                        <div class="list-group sidebar-menu">
                            <a href="@Url.Action("Index", "Products")"
                               class="list-group-item list-group-item-action @(currentController == "Products" && (currentAction == "Index" || currentAction == "Delete") ? "active" : "")">
                                Câu 2: Danh sách &amp; Xóa sản phẩm
                            </a>
                            <a href="@Url.Action("Filter", "Products")"
                               class="list-group-item list-group-item-action @(currentAction == "Filter" ? "active" : "")">
                                Câu 3: Lọc &amp; Sắp xếp tồn kho
                            </a>
                            <a href="@Url.Action("StockIn", "Products")"
                               class="list-group-item list-group-item-action @(currentAction == "StockIn" ? "active" : "")">
                                Câu 4a: Nhập kho
                            </a>
                            <a href="@Url.Action("Damaged", "Products")"
                               class="list-group-item list-group-item-action @(currentAction == "Damaged" ? "active" : "")">
                                Câu 4b: Ghi nhận hàng hỏng
                            </a>
                            <a href="@Url.Action("Transfer", "Products")"
                               class="list-group-item list-group-item-action @(currentAction == "Transfer" ? "active" : "")">
                                Câu 5: Điều chuyển hàng
                            </a>
                            <a href="@Url.Action("Create", "Products")"
                               class="list-group-item list-group-item-action @(currentAction == "Create" ? "active" : "")">
                                Câu 6: Thêm sản phẩm mới
                            </a>
                            <a href="@Url.Action("Statistics", "Products")"
                               class="list-group-item list-group-item-action @(currentAction == "Statistics" ? "active" : "")">
                                Câu 7: Thống kê tồn kho
                            </a>
                        </div>
                    </div>
                </div>
            </aside>

            <main class="col-12 col-md-9 col-lg-9">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Thành công:</strong> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Thông báo lỗi:</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="app-footer py-3 mt-auto">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 - Warehouse_24dh111674</span>
            <span><strong>Ngày tháng năm sinh:</strong> 12/01/2006</span>
        </div>
    </footer>

    <script src="~/Scripts/jquery.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
